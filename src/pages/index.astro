---
import Layout from '@layouts/Default.astro';
import RecentBlogPosts from '@components/generic/RecentBlogPosts.astro';
import MobileSocials from '@components/home/MobileSocials.astro';
import { Pill } from '@eliancodes/brutal-ui';
import { Button } from '@eliancodes/brutal-ui';
import { Card } from '@eliancodes/brutal-ui';
import { Image } from "astro:assets";
import EmptyComponent from '@components/home/EmptyComponent.astro';

import headshot from "../assets/headshot.jpg";

const builtWith = [
  { name: 'Astro', url: 'https://astro.build/' },
  { name: 'UnoCSS', url: 'https://uno.antfu.me/' },
  {
    name: 'Content Collections',
    url: 'https://docs.astro.build/en/guides/content-collections/',
  },
  { name: 'RSS', url: 'https://docs.astro.build/en/guides/rss/' },
  {
    name: 'Sitemap',
    url: 'https://docs.astro.build/en/guides/integrations-guide/sitemap/',
  },
  { name: 'Vercel', url: 'https://vercel.com' },
  { name: 'TypeScript', url: 'https://www.typescriptlang.org/' },
];
---

<Layout
  title='Home'
  pageTitle='Raquel Fishes | Home'
  description='Brutal is a minimalistic, neobrutalism theme for Astro.'
>
  <main class='bg-pink p-6'>
    <MobileSocials />
    <section id='about' class='grid md:grid-cols-8 gap-8 mt-4'>
      <h2 class='hidden'>About RaquelFishes</h2>
      <div class='col-span-4'>
        <Card color="yellow">
          <div class='flex flex-col justify-between items-start gap-4'>
            <p class='mt-4 outfit text-2xl md:text-5xl lg:text-7xl'>
              Hola!
            </p>
            <p class='mt-2 outfit text-xl md:text-3xl lg:text-5xl'>
              Soy Raquel Peces, Ingeniera de Software especializada en Computer Graphics. Con experiencia en la producción audiovisual y en motores de simulación y render. 
            </p>
            <Button target={'_self'} href='/blog/'>
              ¿Quieres saber más? &rarr;
            </Button>
          </div>
        </Card>
      </div>
      <Image
		class="object-cover h-full w-full rounded-lg md:col-span-2 border-3 border-black card-shadow"
		src={headshot}
		alt="Elian Van Cutsem"
		width={headshot.width}
		height={headshot.height}
	/>
    <EmptyComponent/>
      </section>
      <section id='built-with' class='grid md:grid-cols-8 gap-8 mt-4'>
        <div class='col-span-2'>
            <Card>
              <h2 class='text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif'>
                Now
              </h2>
              <span class='poppins underline underline-yellow'><a 
                href='https://sive.rs/nowff' target="_blank">What's that?</a></span>
                <span class="relative flex h-3 w-3">
                    <span
                        class="animate-ping absolute inline-flex h-full w-full rounded-full bg-green-400 opacity-75"
                    ></span>
                    <span class="relative inline-flex rounded-full h-3 w-3 bg-green-500"></span>
                    </span>
              <p class='poppins'>
                Actualmente trabajando como Senior Graphics Engineer en Unity.
              </p>
            </Card>
          </div>
      <div class='col-span-2'>
        <Card>
          <h2 class='text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif'>
            Brutal is built with
          </h2>
          <ul class='flex gap-4 flex-wrap'>
            {
              builtWith.map((item) => (
                <li>
                  <Pill>
                    <a
                      class='sanchez'
                      href={item.url}
                      target='_blank'
                      title={`Go to ${item.name}`}
                    >
                      {item.name}
                    </a>
                  </Pill>
                </li>
              ))
            }
          </ul>
        </Card>
      </div>
      <div class='col-span-2'>
        <Card>
          <h2 class='text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif'>
            What is Brutal?
          </h2>
          <p class='poppins'>
            Brutal is a theme built with Astro, UnoCSS by <a
              href='https://www.elian.codes/'>Elian</a
            >. It's a simple, fast, and modern theme that is easy to use and
            customize. Mainly meant to power blogs and personal websites.
          </p>
        </Card>
      </div>
      <div class='col-span-2'>
        <Card>
          <h2 class='text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif'>
            Brutal is built with
          </h2>
          <ul class='flex gap-4 flex-wrap'>
            {
              builtWith.map((item) => (
                <li>
                  <Pill>
                    <a
                      class='sanchez'
                      href={item.url}
                      target='_blank'
                      title={`Go to ${item.name}`}
                    >
                      {item.name}
                    </a>
                  </Pill>
                </li>
              ))
            }
          </ul>
        </Card>
      </div>
    </section>

    <section id='built-with' class='grid md:grid-cols-8 gap-8 mt-4'>
        <div class='col-span-4'>
            <Card>
              <h2 class='text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif'>
                What is Brutal?
              </h2>
              <p class='poppins'>
                Brutal is a theme built with Astro, UnoCSS by <a
                  href='https://www.elian.codes/'>Elian</a
                >. It's a simple, fast, and modern theme that is easy to use and
                customize. Mainly meant to power blogs and personal websites.
              </p>
            </Card>
          </div>
      <div class='col-span-4'>
        <Card>
          <h2 class='text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif'>
            What is Brutal?
          </h2>
          <p class='poppins'>
            Brutal is a theme built with Astro, UnoCSS by <a
              href='https://www.elian.codes/'>Elian</a
            >. It's a simple, fast, and modern theme that is easy to use and
