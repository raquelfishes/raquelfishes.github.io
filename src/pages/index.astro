---
import Layout from '@layouts/Default.astro';
import MobileSocials from '@components/home/MobileSocials.astro';
import AboutMe from '@components/home/AboutMe.astro';
import NowCard from '@components/home/NowCard.astro';
import CanonCard from '@components/home/CanonCard.astro';
import Contact from '@components/home/Contact.astro';
import TimeZone from '@components/home/TimeZone.astro';
import RecentBlogPosts from '@components/blog/RecentBlogPosts.astro';

const interest = [
  { name: 'C++' },
  { name: 'C#' },
  { name: 'Python' },
  { name: 'Unity' },
  { name: 'Orquesta Iuventas' },
  { name: 'Violín' },
  { name: 'Running' },
  { name: 'Gym' },
  { name: 'Computer Graphics' },
  { name: 'Vulkan' },
  { name: 'Viajar' },
  { name: 'Finanzas Personales' },
  { name: 'Inversión' },
  { name: 'Impresión 3D' },
  { name: 'Volar Drones' },
  { name: 'Inversión' },
];
---

<Layout
  title='Home'
  pageTitle='Raquel Fishes | Home'
  description='Brutal is a minimalistic, neobrutalism theme for Astro.'
>
  <main class='flex-grow bg-light-background_index dark:bg-dark-background_index p-6'>
    <MobileSocials />
    <AboutMe />
      
      <section id='built-with' class='grid 
                                    md:grid-cols-2 md:grid-rows-2
                                    lg:grid-cols-3 gap-8 mt-4 flex-container
                                    xl:grid-cols-4'>
        <div><NowCard /></div>
        <div><CanonCard /></div>
        <div class='md:row-start-1 md:col-start-1 md:row-span-2'><Contact /></div>
        <div class='sm:hidden md:hidden lg:block'><TimeZone /></div>
    
        <!--<Countries />-->
    </section>
  <RecentBlogPosts />
  </main>
</Layout>



