---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Default.astro';
import BlogListArticles from '@components/blog/BlogListArticles.astro';

const posts = await getCollection('blog').then((collection) =>
  collection.reverse()
);
---

<Layout
  title='Blog'
  description='Brutal Blog | On this page you can find a collection of blogposts'
  pageTitle='Brutal Blog'
>
<!--<BlogSection tag='behind-the-scenes' posts={posts}/>-->

<BlogListArticles posts={posts} title='Todos los posts'/>

</Layout>
