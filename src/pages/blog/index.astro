---
import { getCollection } from 'astro:content';
import Layout from '@layouts/Default.astro';
import BlogTopArticles from '@components/blog/BlogTopArticles.astro';
import BlogLatestNews from '@components/blog/BlogLatestNews.astro';
import BlogCustomerStories from '@components/blog/BlogCustomerStories.astro';

const posts = await getCollection('blog').then((collection) =>
  collection.reverse()
);
---

<Layout
  title='Blog'
  description='Brutal Blog | On this page you can find a collection of blogposts'
  pageTitle='Brutal Blog'
>
<BlogTopArticles/>
<BlogLatestNews/>
<BlogCustomerStories/>

</Layout>
