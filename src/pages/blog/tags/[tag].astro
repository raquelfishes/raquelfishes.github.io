---
import { getCollection } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import Layout from '@layouts/Default.astro';
import ArticleCard from '@components/blog/ArticleCard.astro';
import ArticleCardDate from '@components/blog/ArticleCardDate.astro';
import BlogListArticles from '@components/blog/BlogListArticles.astro';
import SectionTitle from '@components/blog/SectionTitle.astro';
import Card from '@components/card/RaquelCard.astro';
import { Image } from 'astro:assets';
import moment from 'moment';
import BlogCardHeader from '@components/blog/BlogCardHeader.astro';
import BlogCardList from '@components/blog/BlogCardList.astro';


// Set the locale to Spanish, TODO: make this dynamic with i18n
moment.locale("es"); 


export async function getStaticPaths() {
  // Fetch all posts from the `articles` collection
  const allPosts = await getCollection('articles');
  // Use a Set to collect unique tags
  const tags: string[] = [];

  allPosts.forEach((post) => {
    post.data.tags.forEach((tag) => {
      tags.push(tag.toLowerCase()); // Normalize tags to lowercase
    });
  });

  // Generate paths for all unique tags
  const uniqueTags = Array.from(new Set(tags));
  
  return uniqueTags.map((tag) => {
    return {
      params: { tag }, // Dynamic param `tag` for [tag].astro
      props: {
        tag,
        blogposts: allPosts.filter((post) =>
          post.data.tags.map((t) => t.toLowerCase()).includes(tag) // Normalize during comparison
        ),
      },
    };
  });
}



interface Props {
  tag: string;
  blogposts: CollectionEntry<'articles'>[];
}

const { tag, blogposts } = Astro.props;

// Format the category name
const formattedCategory = tag;
const description = `All articles related to ${formattedCategory}`;

const [firstArticle, ...remainingArticles] = blogposts;


const featured = remainingArticles
    .filter((post) => post.data.top === true)
    .slice(0, 5); // Normalize during comparison

---

<Layout
  title={`Blog: ${tag}`}
  description={`Brutal Blog | All posts tagged with ${tag}`}
  pageTitle={`Brutal Blog | Blogposts tagged with ${tag}`}
>

<div class='mx-auto px-4 sm:px-6 lg:px-8 gap-16 sm:gap-y-24'>
    <div class="flex -mx-4"> <!-- Elimina flex-wrap -->
      <!-- Columna principal -->
      <div class="w-full md:w-2/3 lg:w-2/3 px-4 md:pe-12">
        <SectionTitle title={formattedCategory} />
        
        {firstArticle && (
                <BlogCardHeader post={firstArticle} />
        )}
  
        <div class='grid gap-4 pointer-events-auto m-6'>
          {remainingArticles.map((post) => (
            <BlogCardList post={post} />
          ))}
        </div>
      </div>
    
      <!-- Sidebar -->
      <div class="w-full md:w-1/3 lg:w-1/3 px-4">
        <div class="sticky top-4"> <!-- Envuelve el contenido del sidebar en un div sticky -->
          <SectionTitle title="Destacados" />
          <div class='grid gap-4 pointer-events-auto m-6'>
            {featured.map((post, index) => (
              <Card href={`/blog/${post.id}`} hrefText="Lee el post" classList='p-4 mb-4'>
                <span before={`${String(index + 1).padStart(2, '0')}`}
                  class='before:content-[attr(before)] before:text-2xl before:mr-2 before:text-gray-500 before:italic before:absolute before:mr-4'>
                  <h3 class='text-xl font-bold mb-4 mt-8 relative'>{post.data.title}</h3>
                </span>
              </Card>
            ))}
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
