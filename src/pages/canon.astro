---
import Layout from '@layouts/Default.astro';
import CanonSection from '@components/canon/CanonSection.astro';
import { getCollection, getEntries } from 'astro:content';

const canonInfo = await getCollection('canon');

---

<Layout
  title='Canon'
  pageTitle='Raquel Fishes | Canon'
  description='Canon Page.'
>
<main class='flex-grow bg-white p-6'>
    <h1 class='text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif'>
        Canon
    </h1>
    <p class='poppins'>
        Una colección de conceptos, citas, artículos, obras, etc. que han influido en mi forma de pensar, mi trabajo y mi arte.
    </p>
    {canonInfo.map((info) => (
        <CanonSection info={info}></CanonSection>
      ))}

</main>

</Layout>