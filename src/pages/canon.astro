---
import Layout from '@layouts/Default.astro';
import CanonSection from '@components/canon/CanonSection.astro';
import SideBar from '@components/generic/SideBar.astro';
import { getCollection, getEntries } from 'astro:content';

const canonInfo = await getCollection('canon');

// Sort canon entries by order field
const canonSorted = canonInfo
    .filter((entry) => entry.data.enable)
    .sort((a, b) => {
    return a.data.order - b.data.order;
});

// Extract titles into an array
const titles = canonSorted.map((entry) => ({
    text: entry.data.title,
    slug: entry.data.title,
    depth: 1
}));

---

<Layout
  title='Canon'
  pageTitle='Raquel Fishes | Canon'
  description='Canon Page.'
>
<main class="p-6 lg:grid lg:grid-cols-8 gap-6 bg-light-background_page dark:bg-dark-background_page">
    <!-- Sidebar stays in the first column -->
    <SideBar headings={titles as any[]} />
  
    <!-- Main content (div) takes the remaining 2 columns -->
    <div class="text-light-text dark:text-dark-text lg:col-span-6 w-full poppins">
      <h1 class="text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif">
        Canon
      </h1>
      <p class="poppins">
        Una colección de conceptos, citas, artículos, obras, etc. que han influido en mi forma de pensar, mi trabajo y mi arte.
      </p>
      <!-- Example content -->
      {canonSorted.map((info) => (
        info.data.enable ? <CanonSection info={info}></CanonSection> : null
      ))}
    </div>
  </main>
</Layout>