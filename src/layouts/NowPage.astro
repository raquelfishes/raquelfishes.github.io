---
import Layout from './Default.astro';
import SideBar from '@components/generic/SideBar.astro';
import NowContent from '@components/now/NowContent.astro';
import LatestNowPosts from '@components/now/LatestNowPosts.astro';

interface Props {
  author: string;
  pubDate: Date;
  headings: unknown;
  title: string;
}

const { author, pubDate, headings, title } = Astro.props;
---

<Layout title={title} description="blalbla">
  <main class='p-6 lg:grid flex justify-center bg-light-background_page text-light-text_page dark:bg-dark-background_page dadrk:text-dark-text_page'>
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl grid grid-cols-[1fr_3fr]">
    <SideBar headings={headings as any[]} />
    <NowContent {pubDate} {author}>
      <slot />
    </NowContent>
    
  <!-- LatestNowPosts component will display the latest 6 posts -->
  <section class='p-6'>
    <LatestNowPosts count={6} />
  </section>
</main>
</Layout>
