---
import Layout from './Default.astro';
import { getCollection } from 'astro:content';
import BlogPostContent from '@components/blog/BlogPostContent.astro';
import BlogRelatedPosts from '@components/blog/BlogRelatedPosts.astro';


// Fetch all articles from the content collection
const articles = await getCollection('blog');

// Get the dynamic slug from the URL
const { slug } = Astro.params;

const { title, description, tags, authors, pubDate, image, headings, _path } = Astro.props;

// Fetch related articles based on categories
const relatedArticles = articles
  .filter(
    (article) =>
      article.data.tags?.some((category) => tags?.includes(category)) &&
      article.id !== slug
  )
  .slice(0, 3); // Limit to 3 related articles
---

<Layout title={title} description={description} ogImage={image}>
  <main class='p-6 lg:grid flex justify-center'>
    <div class="mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl">
    <BlogPostContent headings={headings as any[]} tags={tags} title={title} description={description} pubDate={pubDate} image={image} authors={authors}>
        <slot/>
    </BlogPostContent>

    <BlogRelatedPosts relatedArticles={relatedArticles}/>
    
    </div>
  </main>
</Layout>
