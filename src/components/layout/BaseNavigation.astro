---
import { Icon } from 'astro-icon/components';
import ThemeIcon from '@components/layout/ThemeIcon.astro';

interface Props {
  pageTitle?: string;
}

const navigationItems = [
  { name: 'Home', url: '/' },
  { name: 'Now', url: '/now/' },
];

const socialIcons = [
  {
    name: 'GitHub',
    url: 'https://github.com/raquelfishes',
    icon: 'ri:github-fill',
  },
  {
    name: 'X',
    url: 'https://www.x.com/raquelfishes',
    icon: 'ri:twitter-x-fill',
  },
  { name: 'RSS', url: '/feed.xml', icon: 'uil:rss' },
];

const { pageTitle } = Astro.props;
---

<header class='border-b-4 border-black bg-light-bg_header_fooger text-light-text_header_footer dark:bg-dark-bg_header_footer dark:text-dark-text_header_footer flex justify-between p-6 items-center'>
  {pageTitle && <h1 class='hidden'>{pageTitle}</h1>}
  <a href='/' title='Back to Home'>
    <p class='righteous md:text-5xl'>RaquelFishes</p>
  </a>
  <nav class='inline-block md:hidden'>
    <div class='flex'><ThemeIcon/></div>
  </nav>
  <nav class='hidden md:inline-block'>
    <h2 class='hidden'>Navigation</h2>
    
    <ul class='flex gap-8 poppins'>
      <li><ThemeIcon/></li>
      {
        navigationItems.map((item) => (
          <li>
            <a
              class='text-lg font-medium hover:text-green hover:underline transition-all duration-150 ease-in-out'
              href={item.url}
              title={`Go to ${item.name}`}
            >
              {item.name}
            </a>
          </li>
        ))
      }
      {
        socialIcons.map((item) => (
          <li>
            <a
              href={item.url}
              class='hover:text-green hover:underline transition-all duration-150 ease-in-out'
              target='_blank'
              title={`'See @RaquelFishes on ${item.name}`}
            >
              <Icon name={item.icon} class='inline-block' />
            </a>
          </li>
        ))
      }
    </ul>
  </nav>
  <nav class='md:hidden flex'>
    <h2 class='hidden'>Mobile Navigation</h2>
    <ul>
      <li><a href='/blog/'>Blog</a></li>
    </ul>
  </nav>
</header>
