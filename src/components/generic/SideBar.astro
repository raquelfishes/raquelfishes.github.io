---
interface Props {
  headings: Array<Object>;
}

const { headings } = Astro.props;
---

<aside>
  <nav class='hidden lg:block sticky top-6 ml-8'>
    <ul>
      {headings.map((heading: any) => (
        <li class='py-1'>
          {[...Array(heading.depth - 1)].map((_, _i) => (
            <span class='inline-block w-4' />
          ))}
          <a
            class='hover:text-stone transition-all duration-150 ease-in-out text-light-sidebar_text dark:text-dark-sidebar_text poppins '
            href={`#${heading.slug}`}
            data-slug={heading.slug}
          >
            <span class="text-light-sidebar_symbol dark:text-dark-sidebar_symbol">&gt;</span>{heading.text}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</aside>
