---
import colors from './style/colors.json'
import ALink from '@components/generic/ALink.astro';


interface Props {
  color?: string | undefined;
  href?: string | undefined;
  hrefText?: string | undefined;
  classList?: string;
}

if (Astro.props.color === undefined) {
  Astro.props.color =
    colors[Math.floor(Math.random() * colors.length)];
}

const { color, href, hrefText, classList } = Astro.props;

---

<style>
  div.brutal-card {
    filter: drop-shadow(7px 7px 0 rgb(0 0 0 / 1));
  }
  div.brutal-card:hover {
    filter: drop-shadow(5px 5px 0 rgb(0 0 0 / 1));
  }
  
</style>


<!--<div class={`brutal-card shadow-[7px_7px_0_${theme === 'light' ? 'light-shadowColor' : 'dark-shadowColor'}] hover:shadow-[5px_5px_0_${theme === 'light' ? 'light-shadowColor' : 'dark-shadowColor'}]`}></div>-->
<div class:list={[classList]+' brutal-card group overflow-hidden border-2 border-black transition-all duration-500 ease-in-out rounded-lg'}>
    { href ? (
    <ALink classList="absolute top-2 right-2 bg-black text-white px-2 py-0.5 rounded-sm text-xs z-10 transition-transform duration-500 hover:translate-1" href={href} hrefText={hrefText}/>
    ) : null}
  <slot />
</div>
