---
// This is the TypeScript/JS logic section in Astro.
import { getCollection } from 'astro:content'; // Import for fetching data from content collections
import ArticleCardAuthors from './ArticleCardAuthors.astro';
import ArticleCardDate from './ArticleCardDate.astro';
import ArticleCardWide from './ArticleCardWide.astro';
import UCard from './UCard.astro';
import ULandingSection from './ULandingSection.astro';

// Async function to fetch articles simulating `useAsyncData`
const articles = await getCollection('articles');

const filteredArticles = articles
  .filter((entry) => entry.data.top === true) // Filter by `top`
  .map((entry) => ({
    _path: "blog/" + entry.id || "#", // Provide fallback URL
    title: entry.data.title || "Untitled Article", // Fallback title
    tags: entry.data.tags || [],
    description: entry.data.description || "No description available.", // Fallback description
    pubDate: entry.data.pubDate || new Date("1970-01-01"), // Fallback to epoch if missing
    image: entry.data.image || {
      src: "/placeholder-image.jpg",
      alt: "Placeholder image",
    }, // Provide fallback image
    authors: entry.data.authors || [], // Fallback for authors
  }))
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime()) // Sort by date
  .slice(0, 4); // Limit to 4 articles

// Compute the first article and the remaining articles
const firstArticle = filteredArticles[0];
const remainingArticles = filteredArticles.slice(1);
---
<section class="py-24 sm:py-32">
    <div class='mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl gap-16 sm:gap-y-24 flex flex-col'>
<ULandingSection>
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-16">
    <!-- First Article Card -->
    {firstArticle && (
      <UCard 
        ui={{
          base: 'relative group',
          body: { base: 'space-y-4', padding: '' },
        }}
      >
        <header>
          <div class="overflow-hidden rounded-lg">
            <img
              src={firstArticle.image.src}
              alt={firstArticle.image.alt}
              class="w-full h-80 lg:h-52 object-cover transform group-hover:scale-[101%] transition-transform ease-in duration-200"
            />
          </div>
          <h3 class="mt-6 text-4xl font-bold">
            <a href={`/${firstArticle._path}/`}>
              <span class="absolute inset-0 z-10"></span>
              <span>{firstArticle.title}</span>
            </a>
          </h3>
        </header>
        <p class="text-stone-500">{firstArticle.description}</p>
        <footer>
          {(firstArticle.pubDate || firstArticle.authors) && (
            <dl class="flex justify-between items-center text-sm">
              {firstArticle.pubDate && (
                <>
                  <dt class="sr-only">Published at</dt>
                  <dd>
                    <ArticleCardDate date={firstArticle.pubDate} />
                  </dd>
                </>
              )}
            </dl>
          )}
        </footer>
      </UCard>
    )}
    <!-- Remaining Articles -->
    <div class="flex flex-col gap-8">
      {remainingArticles.map((article) => (
        <ArticleCardWide
          to={article._path}
          title={article.title}
          description={article.description}
          image={article.image}
        />
      ))}
    </div>
  </div>
</ULandingSection>
</div>
</section>
