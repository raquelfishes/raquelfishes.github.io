---
import { getCollection } from 'astro:content'; // For content collection fetching in Astro
import ArticleCard from './ArticleCard.astro'; // Import the `ArticleCard` component
import ULandingSection from './ULandingSection.astro'; // Import the `ULandingSection` component

// Async function to fetch articles simulating `useAsyncData`
const articles = await getCollection('articles');

const filteredArticles = articles
  .filter((entry) => entry.data.top === true) // Filter by `top`
  .map((entry) => ({
    _path: entry.id || "#", // Provide fallback URL
    title: entry.data.title || "Untitled Article", // Fallback title
    tags: entry.data.tags || [],
    description: entry.data.description || "No description available.", // Fallback description
    pubDate: entry.data.pubDate || new Date("1970-01-01"), // Fallback to epoch if missing
    image: entry.data.image || {
      src: "/placeholder-image.jpg",
      alt: "Placeholder image",
    }, // Provide fallback image
    authors: entry.data.authors || [], // Fallback for authors
  }))
  .sort((a, b) => b.pubDate.getTime() - a.pubDate.getTime()) // Sort by date
  .slice(0, 4); // Limit to 4 articles
  
---
<ULandingSection title="Latest news">
  <div class="bg-yellow-800/5 p-4 xl:-m-12 lg:p-12 rounded-lg grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
    {filteredArticles.map((article) => (
      <ArticleCard
        key={article._path}
        to={article._path}
        title={article.title}
        description={article.description}
        date={article.pubDate}
        image={article.image}
        authors={article.authors}
        class="bg-transparent"
      />
    ))}
  </div>
</ULandingSection>
