---
import { Icon } from 'astro-icon/components';

// Get the dynamic slug from the URL
const { url=Astro.request.url} = Astro.props;

const { title } = Astro.props;
---

<div class="flex md:flex-col gap-4 mt-8">
    <a
      href={`https://x.com/intent/tweet?text=${title}&url=${url}`}
      target="_blank"
      rel="nofollow noopener noreferrer"
    >
    <Icon name='logos:x' class='inline-block hover:underline' />
    </a>
    <a
      href={`https://www.linkedin.com/shareArticle?url=${url}`}
      target="_blank"
      rel="nofollow noopener noreferrer"
      class="text-blue-500 hover:underline"
    >
    <Icon name='logos:linkedin-icon' class='inline-block' />
    </a>
    <a
      href={`whatsapp://send?text=${title} ${url}`}
      target="_blank"
      rel="nofollow noopener noreferrer"
      class="text-blue-500 hover:underline"
    >
    <Icon name='logos:whatsapp-monochrome-icon' class='inline-block' />
    </a>
</div>