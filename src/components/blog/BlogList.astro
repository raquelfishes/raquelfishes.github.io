---
import type { CollectionEntry } from 'astro:content';
import BlogCardImageHorizontal from './BlogCardImageHorizontal.astro';

interface Props {
  posts: CollectionEntry<'articles'>[];
}

const { posts } = Astro.props;

---

<ul class='grid md:grid-cols-2 lg:grid-cols-3 gap-8 mb-4'>
  {
    posts.map((post) => {
      return (
        <li>
          <BlogCardImageHorizontal post={post} />
        </li>
      );
    })
  }
</ul>
