---
import Card from '@components/card/RaquelCard.astro';
import { Image } from 'astro:assets';
import moment from 'moment';

// Set the locale to Spanish, TODO: make this dynamic with i18n
moment.locale("es"); 

const { post } = Astro.props;
---
<Card href={`/blog/${post.id}`} hrefText="Lee el post">
    <div class="flex gap-8 h-full">
      <div class='relative h-full overflow-hidden'>
        <Image 
          src={post.data.image.src}
          alt={post.data.image.alt}
          width={200}
          height={100}
          class='rounded h-full object-cover flex-col'
        />
      </div>
      <div class="mr-2">
        <h3 class='text-l font-bold mb-4 mt-8'>{post.data.title}</h3>
        <p>{post.data.description}</p>
        <p class="text-gray-800 mb-8">{moment(post.data.pubDate).format("DD [de] MMMM [de] YYYY")}</p>
      </div>
    </div>
  </Card>