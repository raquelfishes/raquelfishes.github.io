---
import type { CollectionEntry } from 'astro:content';
import SectionTitle from '@components/blog/SectionTitle.astro';
import Card from '@components/card/RaquelCard.astro';
import { Image } from 'astro:assets';
import moment from 'moment';
import BlogCardImageVertical from './BlogCardImageVertical.astro';


// Set the locale to Spanish, TODO: make this dynamic with i18n
moment.locale("es"); 

interface Props {
    posts: CollectionEntry<'articles'>[];
}

const { posts } = Astro.props;

const featured = posts
    .filter((post) => post.data.top === true)
    .slice(0, 5); // Normalize during comparison


---

<div class='mx-auto px-4 sm:px-6 lg:px-8 gap-16 sm:gap-y-24'>
<div class="flex flex-wrap -mx-4">
    <!-- Columna principal -->
    <div class="w-full md:w-2/3 lg:w-2/3 px-4 md:pe-12">
      <SectionTitle title="Todos los posts" />
      
      <div class='grid gap-4 pointer-events-auto m-6'>
        {posts.map((post) => (
            <Card href={`/blog/${post.id}`} hrefText="Lee el post">
            <div class="flex gap-8 h-full">
                <div class='relative h-full overflow-hidden'>
                    <Image 
                    src={post.data.image.src}
                        alt={post.data.image.alt}
                        width={200}
                        height={100}
                    class='rounded h-full object-cover flex-col'/>
                </div>
                <div class="mr-2">
                    <h3 class='text-l font-bold mb-4 mt-8'>{post.data.title}</h3>
                    <p>{post.data.description}</p>
                    <p class="text-gray-800 mb-8">{moment(post.data.pubDate).format("DD [de] MMMM [de] YYYY")}</p>
                </div>
            </div>
            </Card>
        ))}
    </div>
    </div>
  
    <!-- Sidebar -->
    <div class="w-full md:w-1/3 lg:w-1/3 px-4 sticky top-4">
        <SectionTitle title="Destacados" />
        <div class='grid gap-4 pointer-events-auto m-6'>
            {featured.map((post, index) => (
                <Card href={`/blog/${post.id}`} hrefText="Lee el post" classList='p-4 mb-4'>
                    <span before={`${String(index + 1).padStart(2, '0')}`}
                        class='before:content-[attr(before)] before:text-2xl before:mr-2 before:text-gray-500 before:italic before:absolute before:mr-4'>
                        <h3 class='text-xl font-bold mb-4 mt-8 relative'>{post.data.title}</h3>
                    </span>
                </Card>
            ))}
      </div>
    </div>
</div>
</div>
