---
const {
  to,
  title,
  description,
  image = null,
} = Astro.props;
---
<UCard ui={{ base: "relative group", body: { padding: "" } }}>
  <header class="grid grid-cols-5 gap-5 items-center">
    {image && (
      <div class="overflow-hidden rounded-md col-span-2">
        <img
          src={image.src}
          alt={image.alt}
          class="aspect-[16/9] object-cover transform group-hover:scale-[101%] transition-transform ease-in duration-200"
        />
      </div>
    )}

    <div class="col-span-3">
      <h3 class="text-lg font-semibold">
        <a href={to} class="relative block">
          <span class="absolute inset-0 z-10"></span>
          <span>{title}</span>
        </a>
      </h3>

      <p class="mt-1 text-stone-500 text-sm">
        {description}
      </p>
    </div>
  </header>
</UCard>
