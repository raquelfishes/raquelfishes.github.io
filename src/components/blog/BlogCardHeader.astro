---
import Card from '@components/card/RaquelCard.astro';
import { Image } from 'astro:assets';

const { post, classList } = Astro.props;
---
<Card href={`/blog/${post.id}`} hrefText='Lee el post' classList={classList}>
    <div class="article-card">
        <header>
            <a class="overflow-hidden rounded-md" href={`/blog/${post.id}`}>
                <Image 
                    src={post.data.image.src}
                    alt={post.data.image.alt}
                    width={800}
                    height={400}
                    class='w-full h-96 object-cover transform group-hover:scale-[101%] transition-transform ease-in duration-200'/>
            </a>
            <div class='p-4'>
                <h3 class="mt-6 text-2xl font-semibold">
                <a class="block relative underline underline-blue" href={`/blog/${post.id}`}>
                    {post.data.title}
                </a>
                </h3>
            </div>
        </header>

        <p class="p-4 mt-2 text-xl mb-8">
            <span class="font-bold">RPV;</span>
            {post.data.description}
        </p>
    </div>
</Card>