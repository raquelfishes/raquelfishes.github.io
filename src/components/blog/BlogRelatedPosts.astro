---
import BlogCardImageHorizontal from '@components/blog/BlogCardImageHorizontal.astro';
import type { CollectionEntry } from 'astro:content';

interface Props {
    relatedArticles: CollectionEntry<'articles'>[];
}

const { relatedArticles } = Astro.props;

---
<section class="mt-12">
    <h2 class="text-2xl font-bold mb-4">Artículos Relacionados</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {relatedArticles.map((article) => (
        <BlogCardImageHorizontal post={article} />
      ))}
    </div>
</section>