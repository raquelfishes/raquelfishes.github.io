---
import ALink from '@components/generic/ALink.astro';

const { tags } = Astro.props;

---

<!-- Categories -->
<div class="mb-3 text-sm/6 font-semibold text-primary flex items-center gap-1.5">
    {tags?.map((category, index) => (
      <>
        <ALink href={`/blog/tags/${category}`} classList="text-blue-500 hover:underline" hrefText={category} />
        {index < tags.length - 1 && <span> - </span>}
      </>
    ))}
  </div>