---
  const { title, description, links = [], align = 'center', children } = Astro.props;
---
  
<section class={`py-12 text-${align}`}>
<div class="container mx-auto px-8">
    <h2 class="text-3xl font-bold">{title}</h2>
    <p class="mt-4 text-gray-500">{description}</p>
    {links.length > 0 && (
    <div class="mt-6 flex gap-4">
        {links.map((link) => (
        <a
            href={link.to}
            class={`px-4 py-2 rounded bg-${link.color ? link.color : 'gray'}-100 hover:bg-${link.color ? link.color : 'gray'}-200`}
        >
            {link.label}
        </a>
        ))}
    </div>
    )}
    <div class="mt-8"><slot/></div>
</div>
</section>
  