---
const { authors = [] } = Astro.props;
---
{authors.length > 1 ? (
  <UAvatarGroup size="xs" max={3}>
    {authors.map((author) => (
      <UAvatar
        key={author.name}
        src={author.avatar}
        alt={author.name}
      />
    ))}
  </UAvatarGroup>
) : authors[0] ? (
  <div class="flex items-center gap-2 text-sm">
    <UAvatar
      src={authors[0].avatar}
      alt={authors[0].name}
      size="xs"
    />
    <span>{authors[0].name}</span>
  </div>
) : (
  ''
)}
