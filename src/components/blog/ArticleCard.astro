---
import ArticleCardAuthors from "./ArticleCardAuthors.astro";
import ArticleCardDate from "./ArticleCardDate.astro";
import UCard from "./UCard.astro";


const {
  to,
  title,
  description,
  date = '',
  image = null,
  authors = [],
} = Astro.props;
---
<UCard as="article" ui={{ base: "relative group" }}>
<div class="article-card">
  <header>
    {image && (
      <div class="overflow-hidden rounded-md">
        <img
          src={image.src}
          alt={image.alt}
          class="w-full h-48 object-cover transform group-hover:scale-[101%] transition-transform ease-in duration-200"
        />
      </div>
    )}

    <h3 class="mt-6 text-lg font-semibold">
      <a href={`/blog/${to}/`} class="block relative">
        <span class="absolute inset-0 z-10"></span>
        <span>{title}</span>
      </a>
    </h3>
  </header>

  <p class="mt-2 text-stone-500">
    {description}
  </p>

  <footer class="mt-4">
    {(date || authors.length > 0) && (
      <dl class="flex justify-between items-center text-sm">
        {date && (
          <>
            <dt class="sr-only">Published date</dt>
            <dd>
              <ArticleCardDate date={date} />
            </dd>
          </>
        )}
      </dl>
    )}
  </footer>
</div>
</UCard>
<slot/>
