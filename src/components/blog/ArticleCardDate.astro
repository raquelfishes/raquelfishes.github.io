---
const { date } = Astro.props;

// Utility function for date formatting
function formatDate(dateString) {
  const dateObject = new Date(dateString);
  return dateObject.toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
  });
}
---
<time datetime={date}>
  {formatDate(date)}
</time>
