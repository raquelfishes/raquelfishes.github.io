---
import { getCollection } from 'astro:content';
import BlogList from '../blog/BlogList.astro';
import Card from '@components/card/RaquelCard.astro';

interface Props {
  count?: number;
}

const { count } = Astro.props;

const posts = await getCollection('articles').then((posts) =>
  posts.reverse().slice(0, count ?? 3)
);

---

<section class='mt-8'>
  
  <Card href='/blog' hrefText='Blog'>
    <div class='flex justify-between items-start'>
      <h2 class='text-2xl md:text-4xl lg:text-6xl mb-8 dm-serif'>
        Últimos posts:
      </h2>
    </div>
    <BlogList posts={posts} />
  </Card>
</section>
