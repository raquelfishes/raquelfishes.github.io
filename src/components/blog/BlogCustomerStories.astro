---
import { getCollection } from 'astro:content';
import ArticleCardWide from './ArticleCardWide.astro';
import ULandingSection from './ULandingSection.astro';

// Fetch the latest "customer-stories" articles
const articles = await getCollection('articles');

// Filter and sort the articles data
const customerStories = articles
  .filter((article) =>
    article.data.tags &&
    article.data.tags.includes('customer-stories')
  )
  .sort((a, b) => new Date(b.data.pubDate).getTime() - new Date(a.data.pubDate).getTime()) // Sort by date (newest first)
  .slice(0, 3); // Limit to 3 articles
---
<div class='mx-auto px-4 sm:px-6 lg:px-8 max-w-7xl gap-16 sm:gap-y-24 grid lg:grid-cols-2 lg:items-center'>
<ULandingSection
  title="They trust us"
  description="We are proud to have worked with some of the best companies in the world."
  links={[
    {
      label: 'Our Customer Stories',
      color: 'gray',
      trailingIcon: 'i-heroicons-arrow-right',
      size: 'lg',
      to: '/blog/tags/customer-stories',
    },
  ]}
  align="left"
>
  <div class="flex flex-col gap-4">
    {customerStories.map((article) => (
      <ArticleCardWide
        key={article.id}
        to={article.id}
        title={article.data.title}
        description={article.data.description}
        image={article.data.image}
      />
    ))}
  </div>
</ULandingSection>
</div>