---
import {Icon} from 'astro-icon/components'
import RaquelCard from '@components/card/RaquelCard.astro'
import { Button } from '@eliancodes/brutal-ui';

// Define icons per type.
const getIcon = (type) => {
  switch (type) {
    case 'book':
      return 'uil:book-open';
    case 'quote':
      return 'uil:comment-dots';
    case 'article':
      return 'uil:newspaper';
    case 'movie':
      return 'uil:film';
    case 'concept':
      return 'uil:lightbulb-alt';
    case 'image':
        return 'uil:camera';
    case 'podcast':
        return 'uil:microphone';
    case 'music':
        return 'uil:music';
    case 'person':
        return 'uil:user';
    default:
      return 'uil:question-circle'; // Default icon
  }
};
    
const getColor = (type) => {
  switch (type) {
    case 'book':
      return "#c084fc";
    case 'quote':
      return "#f472b6";
    case 'article':
      return "#fb7185";
    case 'movie':
      return "#e879f9";
    case 'concept':
      return "#a78bfa";
    case 'image':
        return "#818cf8";
    case 'podcast':
        return "#60a5fa";
    case 'music':
        return "#38bdf8";
    case 'person':
        return "#22d3ee";
    default:
      return "#ffffff";
  }
};

const { canonItem } = Astro.props; // Destructure the single `canonItem` passed from `CanonList`
---

<style>
div.canon-card-header {
    background-color: var(--heading-color);
    border-radius: 0.1rem;
    border: 1px solid grey;
    text-align: center;
    text-transform: capitalize;
}
.icon-inline{
    vertical-align: middle;
    display: inline-block;
    margin-right: 0.5rem;
}

blockquote::before {
    content: "\"";
    display: inline-block;
    font-size: 4em;
    line-height: 0.01;
    opacity: 0.5;
    vertical-align: -1rem;
}

p.blockquote {
    display: inline;
}

.canon-card {
    min-height:200px;
    flex-grow: 1;
}

.flex-container {
    display: flex;
    flex-direction: column; /* Stack children vertically */
    height: 100%; /* Ensure the card takes full height */
  }

.canon-card-footer {
    background: grey;
    box-shadow: 0 -5px 20px rgba(0, 0, 0, 0.1); /* Adds a soft shadow above */
    border-radius: 8px 8px 8px 8px; /* Rounded corners for the footer */
    text-align: center;
    padding: 1rem 0;
}
</style>


<RaquelCard color="white">
<div class="flex-container">
    <div class="canon-card-header" style={`--heading-color: ${getColor(canonItem.type)}`}>
        <h2 class="sanchez mt-2 mb-2 text-lg md:text-xl lg:text-3xl">
            <Icon name={getIcon(canonItem.type)} class="icon-inline"/>{canonItem.type}
        </h2>
    </div>
    <div class="flex-grow canon-card ml-4 mr-4">
        <p class='mt-4 outfit text-2xl md:text-4xl lg:text-4xl'>
            {canonItem.title}
        </p>
        {
            canonItem.quote ? (
            <blockquote class="mt-2 opacity-70">
                <p class='text-xl md:text-3xl lg:text-2xl italic blockquote'>{canonItem.quote}</p>
            </blockquote>
            ):(<slot/>)
        }
        <p class='mt-2 outfit text-xl md:text-3xl lg:text-2xl'>{canonItem.text}</p>
    </div>
    {
        canonItem.link ? (
            <footer class="canon-card-footer mt-8">
                <Button target={'_self'} href={canonItem.link}>
                Link &rarr;
            </Button>
        </footer>
        ) : (
        <slot/>
        )
    }
</div>
</RaquelCard>