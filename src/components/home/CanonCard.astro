---
import Card from '@components/card/RaquelCard.astro';
import ALink from '@components/generic/ALink.astro';
---
<div class='col-span-2'>
    <Card href='/canon' hrefText='Canon'>
        <h2 class='text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif'>Raíces</h2>
        <ALink classList='poppins underline underline-blue' href='https://www.brendanschlagel.com/2017/11/05/canonize-creating-personal-canon-template/' hrefText='¿Qué es esto?'/>
        <p class='poppins'>
            Una coleccion de conceptos, citas, artículos y más, que han dejado su marca en mi vida.<br> Una bibliografía de influencias.  
        </p>
    </Card>
</div>