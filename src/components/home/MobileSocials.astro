---
import { Icon } from 'astro-icon/components';

const socials = [
  {
    name: 'GitHub',
    url: 'https://github.com/raquelfishes',
    icon: 'ri:github-fill',
  },
  {
    name: 'Twitter',
    url: 'https://www.twitter.com/raquelfishes',
    icon: 'ri:twitter-x-fill',
  },
  {
    name: 'LinkedIn',
    url: 'https://www.linkedin.com/in/raquelpeces',
    icon: 'ri:linkedin-fill',
  },
];
---

<section class='md:hidden'>
  <h2 class='hidden'>Socials section</h2>
  <ul class='flex justify-between'>
    {
      socials.map((item) => (
        <li class='bg-light-bg_header_footer text-light-text_header_footer dark:bg-dark-bg_header_footer dark:text-dark-text_header_footer px-4 py-2 border-black border-2 rounded card-shadow'>
          <a href={item.url} target='_blank' title={`Go to ${item.name}`}>
            <Icon name={item.icon} class='inline-block text-2xl' />
          </a>
        </li>
      ))
    }
  </ul>
</section>
