---
import Card from '@components/card/RaquelCard.astro';
import ALink from '@components/generic/ALink.astro';
import { Icon } from 'astro-icon/components';
---
<Card color='#2dd4bf' classList="p-4">
    <h2 class='text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif'>¿Hablamos?</h2>
    <p class='poppins m opacity-80 mt-4'>Mi buzón está abierto</p>
    <ALink classList='poppins underline decoration-yellow-500' href='mailto:raquelpm23+web@gmail.com' hrefText='raquelpm23@gmail.com'/>
    <p class='poppins m opacity-80 mt-4'>También puedes encontrarme en las rrss</p>
    <p class='poppins'>
    <Icon name='logos:x' class='inline-block' /><ALink classList='poppins underline decoration-yellow-500' href='https://x.com/raquelfishes' hrefText='X (antes Twitter)'/><br>
    <Icon name='logos:github-icon' class='inline-block' /><ALink classList='poppins underline decoration-yellow-500' href='https://github.com/raquelfishes' hrefText='Github'/><br>
    <Icon name='logos:linkedin-icon' class='inline-block' /><ALink classList='poppins underline decoration-yellow-500' href='https://www.linkedin.com/in/raquelpeces' hrefText='LinkedIn'/><br>
    <Icon name='logos:instagram-icon' class='inline-block' /><ALink classList='poppins underline decoration-yellow-500' href='https://www.instagram.com/raquelfishes' hrefText='Instagram'/><br>
    </p>
</Card>