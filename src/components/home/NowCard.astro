---
import Card from '@components/card/RaquelCard.astro';
import ALink from '@components/generic/ALink.astro';
---
<div class='col-span-2'>
    <Card href='/now' hrefText='Now'>
        <h2 class='text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif'>Hoy es Ahora</h2>
        <ALink classList='poppins underline underline-blue' href='https://sive.rs/nowff' hrefText='¿Qué es esto?'/>
        <p class='poppins'>
            Un espacio donde cuento en qué estoy trabajando y cuáles son mis prioridades en este momento.<br>
            Actualizado regularmente
        </p>
    </Card>
</div>