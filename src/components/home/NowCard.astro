---
import Card from '@components/card/RaquelCard.astro';
import { Button } from '@eliancodes/brutal-ui';
---
<div class='col-span-2'>
    <Card href='/now' hrefText='Now'>
        <div class='grid md:grid-cols-8 gap-8'>
            <div class='col-span-6'>
                <h2 class='text-2xl md:text-4xl lg:text-6xl mb-4 dm-serif'>
                Hoy es Ahora
                </h2>
            </div>
        </div>
        <span class='poppins underline underline-yellow'>
            <a href='https://sive.rs/nowff' target="_blank" class="underline underline-blue" rel="noreferrer noopener">¿Qué es esto?&#8599;</a>
        </span>
        <p class='poppins'>
            Una página donde defino mis focos actuales y lo que estoy haciendo ahora.
        </p>
        <!--
        <Button target={'_self'} href='/now/'>
            Mis focos actuales &rarr;
        </Button>
         -->
    </Card>
</div>